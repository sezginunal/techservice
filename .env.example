# Host port on the local network. Open http://<this-machine>:<FRONTEND_PORT>
FRONTEND_PORT=8080

# Backend listen address inside the Docker network. Not published on the host.
ADDR=:8080

# SQLite file on the sqlite-data volume. Keep it under /data.
DATABASE_PATH=/data/techservice.db

# Uploaded files on the uploads volume. Keep this path at /uploads.
UPLOAD_PATH=/uploads

# First admin, used only when the database has no admin yet.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Name in the browser tab, on the sign-in screen, and in the sidebar.
# Empty keeps Techservice / Teknik servis.
COMPANY_NAME=

# Logo file in the brand directory. Example: /brand/logo.png
# Empty, missing, or a file that is not JPEG, PNG, WebP, or SVG keeps the built-in mark.
LOGO_PATH=

# Device brand and model suggestions. Example: /brand/devices.json
# Empty, missing, or invalid JSON keeps plain brand and model fields.
DEVICE_CATALOG_PATH=
