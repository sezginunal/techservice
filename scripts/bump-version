#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo "usage: scripts/bump-version <message-or-file>" >&2
  exit 1
fi

if [ -f "$1" ]; then
  msg=$(cat "$1")
else
  msg=$1
fi

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
file=$root/VERSION

if [ -f "$file" ]; then
  current=$(tr -d '[:space:]' < "$file")
else
  current=0.0.0
fi

if ! printf '%s\n' "$current" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "bump-version: VERSION must be MAJOR.MINOR.PATCH" >&2
  exit 1
fi

major=$(printf '%s\n' "$current" | cut -d. -f1)
minor=$(printf '%s\n' "$current" | cut -d. -f2)
patch=$(printf '%s\n' "$current" | cut -d. -f3)

subject=$(printf '%s\n' "$msg" | sed -n '1p')
type=$(printf '%s\n' "$subject" | sed -n 's/^\([a-z][a-z]*\).*/\1/p')
case "$type" in
  feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert) ;;
  *)
    echo "bump-version: commit type is missing or unknown" >&2
    exit 1
    ;;
esac

breaking=0
if printf '%s\n' "$subject" | grep -Eq '^[a-z]+(\([^)]+\))?!:'; then
  breaking=1
fi
if printf '%s\n' "$msg" | grep -Eq '^BREAKING[ -]CHANGE:'; then
  breaking=1
fi

if [ "$breaking" -eq 1 ]; then
  major=$((major + 1))
  minor=0
  patch=0
elif [ "$type" = feat ]; then
  minor=$((minor + 1))
  patch=0
else
  patch=$((patch + 1))
fi

next=$major.$minor.$patch
printf '%s\n' "$next" > "$file"
printf '%s\n' "$next"
